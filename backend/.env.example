# Database
DATABASE_URL=postgresql+asyncpg://nutriplan:nutriplan@localhost:5432/nutriplan

# Authentication
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30

# Encryption (recommended for production, falls back to JWT_SECRET in dev)
ENCRYPTION_KEY=

# AI - Gemini (primary, free tier)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CHEAP_MODEL=gemini-2.0-flash-lite
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# RAG (Phase 9)
EMBEDDING_DIMENSION=768
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.35

# AI - OpenAI (fallback, paid)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_CHEAP_MODEL=gpt-4o-mini

# WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# LangSmith (Phase 9 — optional LLM tracing)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=nutriplan

# AI plan generator backend (simple | langchain | langgraph)
PLAN_GENERATOR_BACKEND=simple

# Redis cache (Phase 10)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
CACHE_TTL_SECONDS=300

# Scheduler (Phase 10)
ENABLE_SCHEDULER=false
REMINDER_MORNING_HOUR=7
REMINDER_WEEKLY_HOUR=9

# App settings
APP_NAME=NutriPlan
DEBUG=true
LOG_LEVEL=INFO
SQL_ECHO=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FRONTEND_URL=http://localhost:5173
