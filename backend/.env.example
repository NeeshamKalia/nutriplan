# ============================================================
# NutriPlan — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before running.
# Variables marked [REQUIRED in production] need real values when DEBUG=false.
# Everything else has sensible defaults.
# ============================================================

# ── Environment ──────────────────────────────────────────────
# Options: development | test | production
# When set to "production" (or DEBUG=false), the app validates that
# all required secrets are set and rejects insecure defaults.
# ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────
# [REQUIRED] PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://nutriplan:nutriplan@localhost:5432/nutriplan

# ── Authentication ───────────────────────────────────────────
# [REQUIRED in production] Secret key for JWT signing — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-this-in-production

# [REQUIRED in production] Fernet key for field-level encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_MINUTES=60
# JWT_REFRESH_EXPIRATION_DAYS=30

# ── AI — Gemini (primary, free tier) ────────────────────────
# [REQUIRED for AI features] Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_CHEAP_MODEL=gemini-2.0-flash-lite
# GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── RAG Settings (Phase 9) ──────────────────────────────────
# EMBEDDING_DIMENSION=768
# RAG_TOP_K=3
# RAG_MIN_SIMILARITY=0.35

# ── AI — OpenAI (fallback, paid) ────────────────────────────
# [OPTIONAL] Only needed if Gemini is unavailable
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_CHEAP_MODEL=gpt-4o-mini

# ── WhatsApp Business Cloud API ─────────────────────────────
# [OPTIONAL] Only needed for WhatsApp client messaging
# Get these from Meta Developer Dashboard → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# ── LangSmith Tracing (Phase 9+) ────────────────────────────
# [OPTIONAL] Enable LLM call tracing for debugging
# LANGCHAIN_API_KEY=
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_PROJECT=nutriplan

# ── AI Plan Generator Backend ────────────────────────────────
# Controls which AI pipeline is used for meal plan generation.
# The project evolved through three phases:
#   simple    → Direct Gemini API calls + structured JSON (Phase 4 MVP)
#   langchain → LangChain composability + LangSmith tracing (Phase 9)
#   langgraph → Multi-step stateful workflow + retry on validation (Phase 10)
PLAN_GENERATOR_BACKEND=langgraph

# ── Redis (Phase 10) ────────────────────────────────────────
# [OPTIONAL] Caching layer — app works without it
# REDIS_URL=redis://localhost:6379/0
# REDIS_ENABLED=false
# CACHE_TTL_SECONDS=300

# ── Scheduler ────────────────────────────────────────────────
# [OPTIONAL] Daily WhatsApp reminders (requires WhatsApp setup)
# ENABLE_SCHEDULER=false
# REMINDER_MORNING_HOUR=7
# REMINDER_WEEKLY_HOUR=9

# ── App Settings ─────────────────────────────────────────────
# DEBUG=true                     # Set to false in production
# LOG_LEVEL=INFO                 # DEBUG for dev, INFO for prod
# SQL_ECHO=false                 # Never true in production (leaks query data)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# FRONTEND_URL=http://localhost:5173
